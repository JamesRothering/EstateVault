# Copy to .env and fill in. Never commit .env.

# --- Firefly III (official image; do not fork) ---
APP_KEY=CHANGE_ME_32_CHARS_EXACTLY______
APP_URL=http://localhost:8080
TZ=America/Los_Angeles
SITE_OWNER=james.rothering.codojo@gmail.com
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
STATIC_CRON_TOKEN=CHANGE_ME_32_CHARS_EXACTLY______
TRUSTED_PROXIES=**

# --- Firefly DB container ---
MYSQL_RANDOM_ROOT_PASSWORD=yes
MYSQL_USER=firefly
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_DATABASE=firefly

# --- Estate layer ---
ESTATE_HOST=127.0.0.1
ESTATE_PORT=8090
FIREFLY_URL=http://127.0.0.1:8080
# Personal Access Token from Firefly: Profile → OAuth → Personal Access Tokens
FIREFLY_TOKEN=
# Maximum age in days before financial data is STALE. Default 30.
FRESHNESS_THRESHOLD_DAYS=30
# Enter WARNING this many days before the stale threshold. Default 7.
WARNING_LEAD_DAYS=7
